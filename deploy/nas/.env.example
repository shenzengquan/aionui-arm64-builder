# =============================================================================
# 复制为 .env 后按实际情况修改
# =============================================================================

# 镜像 tag（必须与 GitHub Release 里发布的 tag 一致）
AIONUI_IMAGE_TAG=2.2.2

# NAS 上暴露的端口
AIONUI_PORT=3000

# 【必须修改】数据目录 —— 落在 SATA 卷，不要用 eMMC
# 绿联 UGOS 常见：/volume1/docker/aionui
# 先执行 df -h 确认你的实际挂载点，再填这里。
# 注意：该目录必须在 NAS 上真实存在，否则容器启动会失败。
AIONUI_DATA_DIR=/volume1/docker/aionui

# 内存上限（RK3588 是 8GB 板载内存，不可扩展）
# 如果 NAS 上还跑着别的大内存服务，把它调小，例如 2g
AIONUI_MEM_LIMIT=3g

# 时区
TZ=Asia/Shanghai
